{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh.capability.schema.json",
  "title": "DSH plugin capability manifest",
  "type": "object",
  "required": [
    "id",
    "bucket",
    "owner_capability",
    "risk",
    "reads",
    "writes",
    "side_effects",
    "reversible",
    "conflicts_with",
    "taint_labels",
    "requires_confirm_above",
    "default_presets",
    "forbidden_with"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "bucket": { "type": "string", "enum": ["capability", "skin", "runtime", "host"] },
    "owner_capability": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "reads": { "type": "array", "items": { "type": "string" } },
    "writes": { "type": "array", "items": { "type": "string" } },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "reversible": { "type": "boolean" },
    "conflicts_with": { "type": "array", "items": { "type": "string" } },
    "taint_labels": { "type": "array", "items": { "type": "string" } },
    "requires_confirm_above": { "type": "string" },
    "default_presets": { "type": "array", "items": { "type": "string" } },
    "forbidden_with": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
