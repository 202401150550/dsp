{
  "name": "openviking-dsh-pkg",
  "version": "1.0.0",
  "description": "DSH wrapper for OpenViking: context database with viking:// virtual filesystem. Exposes the openviking-memory skill; MCP server requires a running OpenViking server.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "servers",
    "mcp.json",
    "plugin.json"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "context-database"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
